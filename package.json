{
  "name": "rentri-fir-sender",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "start": "vite preview",
    "start:server": "tsx server/index.ts",
    "db:push": "drizzle-kit push",
    "summary:watch": "tsx server/summaryWatcher.ts",
    "plan:compare": "tsx server/comparePlanWithRentri.ts",
    "plan:coverage": "tsx server/xmlVsRentriCoverage.ts",
    "resend:global": "tsx server/resendExactFromXml.ts test/global-reco_6000.xml.xml R6QSWHZ6HJV certificato.p12 08934760961 200",
    "resend:multy": "tsx server/resendExactFromXml.ts test/multy-proget_6000.xml.xml RQEL39R7NS0 multyproget.p12 12347770013 200",
    "remap:global": "tsx server/sendXmlWithRegistryNumbers.ts test/global-reco_6000.xml.xml R6QSWHZ6HJV certificato.p12 08934760961 200",
    "remap:multy": "tsx server/sendXmlWithRegistryNumbers.ts test/multy-proget_6000.xml.xml RQEL39R7NS0 multyproget.p12 12347770013 200",
    "bulk:xml": "tsx server/bulkSendXml.ts",
    "bulk:strict": "tsx server/strictBulkSend.ts",
    "report:last10": "tsx server/reportLastTenMinutes.ts",
    "proof:global": "tsx server/proofSend.ts global",
    "proof:multy": "tsx server/proofSend.ts multy",
    "smart:send": "tsx server/scripts/smartSender.ts",
    "repair:one": "tsx server/scripts/repairOneByOne.ts",
    "send:fir": "tsx server/scripts/sendFir.ts",
    "send:restructured": "tsx server/scripts/sendRestructured.ts",
    "send:template": "tsx server/scripts/sendFromTemplate.ts",
    "fir:ocr": "tsx server/scripts/ocrToFir.ts --dir \"fir dicembre 2025\" --json \"fir dicembre 2025\\formulari.json\" --out out\\fir.batch.json",
    "fir:clean": "tsx server/scripts/normalizeFirBatch.ts --in out\\fir.batch.json --out out\\fir.batch.cleaned.json",
    "fir:dedup": "tsx server/scripts/dedupFirBatch.ts --in out\\fir.batch.cleaned.json --out out\\fir.batch.final.json",
    "fir:dedup:composite": "tsx server/scripts/dedupFirComposite.ts --in out\\fir.batch.cleaned.json --out out\\fir.batch.final.json",
    "send:fir:batch": "tsx server/scripts/sendFirBatch.ts --in out\\fir.batch.cleaned.json --limit 10",
    "send:retry": "tsx server/scripts/resendFailed.ts --in out\\fir.batch.cleaned.json",
    "reconcile:dec": "tsx server/scripts/reconcile.ts --from 2025-12-01 --to 2025-12-31 --out out\\reconcile_dicembre.csv",
    "export:ocr": "tsx server/scripts/exportOcrMovimenti.ts --in out\\fir.batch.cleaned.json --count 634 --out out",
    "pdf:ocr": "tsx server/scripts/jsonToPdf.ts --in out\\ocr.movimenti.global.json --out out\\ocr.movimenti.global.pdf && tsx server/scripts/jsonToPdf.ts --in out\\ocr.movimenti.multy.json --out out\\ocr.movimenti.multy.pdf",
    "ocr:scan": "tsx server/scripts/ocrScan.ts --dir \"fir dicembre 2025\" --out out\\formulari.json",
    "ocr:csv": "tsx server/scripts/exportOcrCsv.ts --global out\\ocr.movimenti.global.json --multy out\\ocr.movimenti.multy.json --out out\\ocr.fir.mapping.csv",
    "ocr:scan:enh": "tsx server/scripts/ocrScanEnh.ts --dir \"fir dicembre 25\" --out out\\formulari.json",
    "ocr:structured": "tsx server/scripts/structuredOcr.ts --dir \"fir dicembre 25\" --out out\\ocr.structured.json",
    "ocr:structured:csv": "tsx server/scripts/structuredToCsv.ts --in out\\ocr.structured.json --out out\\ocr.structured.csv",
    "ocr:one": "tsx server/scripts/ocrOneFile.ts --file",
    "ocr:build:payload": "tsx server/scripts/buildOcrPayload.ts --in out\\ocr.structured.json --outGlobal out\\ocr.payload.global.json --outMulty out\\ocr.payload.multy.json",
    "send:ocr:global": "tsx server/scripts/sendPayloadFile.ts --in out\\ocr.payload.global.json --registry R6QSWHZ6HJV --filename certificato.p12 --issuer 08934760961",
    "send:ocr:multy": "tsx server/scripts/sendPayloadFile.ts --in out\\ocr.payload.multy.json --registry RQEL39R7NS0 --filename multyproget.p12 --issuer 12347770013"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-aspect-ratio": "^1.0.3",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.0.4",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-toggle-group": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.25.0",
    "@trpc/client": "^11.0.0-rc.300",
    "@trpc/react-query": "^11.0.0-rc.300",
    "@trpc/server": "^11.0.0-rc.300",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-forge": "^1.3.14",
    "axios": "^1.13.5",
    "better-sqlite3": "^11.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.30.4",
    "express": "^4.18.3",
    "fast-xml-parser": "^4.5.3",
    "framer-motion": "^11.0.8",
    "jsonwebtoken": "^9.0.3",
    "lovable-tagger": "^1.1.13",
    "lucide-react": "^0.344.0",
    "node-forge": "^1.3.3",
    "pdfkit": "^0.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "recharts": "^2.12.2",
    "sharp": "^0.34.5",
    "sonner": "^1.4.3",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.7.1",
    "uuid": "^9.0.1",
    "vaul": "^0.9.0",
    "wouter": "^3.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pdfkit": "^0.13.4",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "drizzle-kit": "^0.20.14",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
