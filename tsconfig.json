{
  "compilerOptions": {
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "node",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": [
      "node",
      "vite/client"
    ],
    "useDefineForClassFields": true
  },
  "exclude": [
    "server",
    "drizzle",
    "node_modules"
  ],
  "include": [
    "src"
  ]
}